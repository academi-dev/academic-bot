# ==============================================================================
# Academic Bot — Contenedor Híbrido Node.js + Python para WhatsApp QR (Baileys)
# ==============================================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Instalar Node.js 20 LTS y utilidades básicas para @whiskeysockets/baileys
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Instalar dependencias de Python del motor conversacional
COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

# Instalar dependencias Node.js del conector Baileys
COPY whatsapp_qr/package.json ./whatsapp_qr/package.json
RUN cd whatsapp_qr && npm install --omit=dev

# Copiar código fuente
COPY bot/ ./bot/
COPY whatsapp_qr/index.js ./whatsapp_qr/index.js

EXPOSE 3005

CMD ["node", "whatsapp_qr/index.js"]
